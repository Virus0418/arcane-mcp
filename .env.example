# Required (Arcane API — separate from MCP ingress auth)
ARCANE_BASE_URL=https://arcane.example.com
ARCANE_API_KEY=arc_xxxxxxxxxxxxxxxxx

# MCP ingress auth. Do not mix bearer and oauth on the same process/endpoint;
# run two instances if you need both kinds of clients.
# MCP_AUTH_MODE=bearer
# ARCANE_MCP_AUTH_MODE=bearer

# bearer (default): clients must send Authorization: Bearer <MCP_AUTH_TOKEN>.
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me

# oauth (Logto OIDC / ChatGPT CIMD). Unset MCP_AUTH_TOKEN; it is ignored in this mode.
# MCP_AUTH_MODE=oauth
# Public base URL of this MCP server (no /mcp path). FastMCP alias: FASTMCP_SERVER_AUTH_BASE_URL
# MCP_PUBLIC_BASE_URL=https://mcp.example.com
# Logto OIDC issuer (must end in /oidc, or /oidc is appended). JWKS defaults to {issuer}/jwks
# OAUTH_ISSUER_URL=https://your-tenant.logto.app/oidc
# Logto API Resource indicator; must match the JWT aud claim. Default: {MCP_PUBLIC_BASE_URL}/mcp
# OAUTH_AUDIENCE=https://mcp.example.com/mcp
# Required token scopes (comma-separated). Default: mcp
# OAUTH_SCOPES=mcp
# Optional JWKS override (default {OAUTH_ISSUER_URL}/jwks)
# OAUTH_JWKS_URI=https://your-tenant.logto.app/oidc/jwks
# JWT signing algorithm passed to FastMCP JWTVerifier. Default auto reads the JWKS
# `alg` (or infers ES384 from an EC P-384 key). Logto Cloud uses ES384; fallback is
# ES384 if JWKS cannot be fetched. Pin with ES384 or RS256 if needed.
# Alias: MCP_OAUTH_JWT_ALGORITHM
# OAUTH_JWT_ALGORITHM=auto

# Browser CORS for /mcp (comma-separated origins; prefer an explicit list over *).
# oauth defaults to ChatGPT origins; bearer defaults to empty (no CORS).
# Set empty to disable. Alias: ARCANE_MCP_HTTP_ALLOWED_ORIGINS
# MCP_HTTP_ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://www.chatgpt.com

# Optional
#MCP_HOST=0.0.0.0
#MCP_PORT=8000
#ARCANE_MCP_TAGS=Containers,Images,Volumes,Networks,Projects,Project Workspace,Environments,System,Dashboard,Activities,Events,Ports,Updater,Image Updates,Vulnerabilities,Health,Version
#ARCANE_MCP_EXCLUDE_TAGS=
#ARCANE_MCP_READ_ONLY=false
#ARCANE_MCP_CONFIRM_DESTRUCTIVE=true
# Hand-written container log tail. false hides get_container_logs.
# The OpenAPI /logs/download route stays excluded either way.
#ARCANE_MCP_ENABLE_LOGS=true
#ARCANE_MCP_DESTRUCTIVE_PATTERNS=
#ARCANE_MCP_SPEC_TIMEOUT=60
#ARCANE_MCP_LOG_LEVEL=INFO
